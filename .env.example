# AURELIX — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real credentials.
#   cp .env.example .env

# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — shared cache and (from Phase 2) the cross-process rate budget.
# Without it, caching is in-process only and each worker assumes it owns the whole quota.
REDIS_URL=

# Optional — which block of config/limits.yaml applies. Defaults to the file's active_tier.
# AURELIX_TIER=free

# Optional — root that relative image_paths in claims.csv resolve against.
# Defaults to the repository root.
# AURELIX_IMAGE_ROOT=

# Optional — permit inference from claim text when no image can be loaded.
# OFF by default and should stay off: findings produced this way are guesses, not
# observations, and are marked UNGROUNDED in the justification.
# AURELIX_ALLOW_TEXT_ONLY=false

# Optional — override the config file location.
# AURELIX_CONFIG=config/limits.yaml

# ── Platform backend only ────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///./aurelix.db

# Browser origins allowed to call the API. Comma-separated; `*` means any origin and
# disables credentialed requests (the spec forbids wildcard + credentials, and a browser
# rejects that combination outright rather than being permissive about it).
#   local:      *
#   production: https://your-app.vercel.app
# CORS_ORIGINS=*

# Vercel preview deployments get a fresh hostname per push, so they cannot be enumerated.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Where uploaded claim photographs are written. Defaults to <repo>/var/uploads.
# Ephemeral on a free-tier container: images survive restarts, not redeploys.
# UPLOAD_DIR=

# Upload caps. Per file, and per claim.
# MAX_UPLOAD_BYTES=8388608
# MAX_UPLOAD_FILES=6
